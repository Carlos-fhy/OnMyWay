# Only a Gaode Web Services key, never an Android SDK key.
AMAP_WEB_KEY=
# Minimum delay between outbound map calls. Tune to your account quota.
# Short QPS/HTTP 429 failures retry twice (1s, 2s); key/permission/daily quota errors do not.
# Errors identify the affected service and code. Never put the Android SDK key here.
AMAP_REQUEST_INTERVAL=0.35

# Aliyun voice (configuration reserved; cloud voice wiring follows navigation).
# Server only. Use a Model Studio API key, not an Alibaba AccessKey ID/Secret.
DASHSCOPE_API_KEY=
VOICE_ASR_MODEL=qwen-audio-3.0-asr-flash
VOICE_TTS_MODEL=qwen-audio-3.0-tts-plus
AGENT_MODEL=qwen3.8-max
# Optional: copy the API base URL from your model console for your region/workspace.
DASHSCOPE_BASE_URL=
