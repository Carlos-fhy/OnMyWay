# Only a Gaode Web Services key, never an Android SDK key.
# Also used by the reviewed official Amap MCP via JSON query_env: {"key":"AMAP_WEB_KEY"}.
AMAP_WEB_KEY=
# Minimum delay between outbound map calls. Tune to your account quota.
# Short QPS/HTTP 429 failures retry twice (1s, 2s); key/permission/daily quota errors do not.
# Errors identify the affected service and code. Never put the Android SDK key here.
AMAP_REQUEST_INTERVAL=0.35

# Text model and cloud speech recognition; cloud TTS is not implemented yet.
# Server only. Use a Model Studio API key, not an Alibaba AccessKey ID/Secret.
DASHSCOPE_API_KEY=
VOICE_ASR_MODEL=qwen-audio-3.0-asr-flash
VOICE_TTS_MODEL=qwen-audio-3.0-tts-plus
AGENT_MODEL=qwen3.8-max
# Optional: copy the API base URL from your model console for your region/workspace.
DASHSCOPE_BASE_URL=

# Personal data and Agent API token. Set a unique random value of at least 32 characters.
# Used as X-Backup-Token; enter the same value in the app for sync/memory.
# Keep this file private. Enabling the Agent worker also requires this token.
ONMYWAY_BACKUP_TOKEN=
# Optional; defaults to backend/data/backups.sqlite3.
ONMYWAY_BACKUP_DB=

# Optional intent execution journal; defaults to backend/data/harness.db.
# Contains proposal results; keep private and back up separately from /sync snapshots.
ONMYWAY_HARNESS_DB=

# Optional personal memory DB; defaults to backend/data/personal_memory.sqlite3.
# Not included in /sync snapshots.
ONMYWAY_MEMORY_DB=

# Agent API persists tasks while disabled; true starts model/tool execution.
# Restart the backend after changing these settings.
ONMYWAY_AGENT_WORKER_ENABLED=false
# One-level read-only child tasks, sharing the coordinator's total budget.
# Existing children can still finish and be reviewed when new delegation is disabled.
ONMYWAY_AGENT_DELEGATION_ENABLED=true
# Optional Agent state/results DB; defaults to backend/data/agent.sqlite3.
# Back up separately from /sync snapshots and personal memory.
ONMYWAY_AGENT_DB=
# Worker ownership lease, in seconds (1-300); keep the default unless testing recovery.
ONMYWAY_AGENT_LEASE_SECONDS=90
# Conservative UTF-8 byte-based estimate of model input tokens (1024-14336).
ONMYWAY_AGENT_INPUT_TOKENS=12000
# Optional MCP JSON config path; relative to the backend process working directory.
# Example: backend/data/mcp.servers.json. Empty means built-in tools only.
# See docs/AGENT_RUNTIME.md for the official Amap/Exa JSON example.
# Remote endpoints must match agent_official_services.py and official_service.
# Amap: https://mcp.amap.com/mcp, query_env: {"key":"AMAP_WEB_KEY"}.
# Exa: https://mcp.exa.ai/mcp, query_params: {"tools":"web_search_exa,web_fetch_exa"}.
# Keep allowed_tools explicit; server annotations never grant local permissions.
# Reference private credentials with query_env or headers_env, never inline in URLs.
# Localhost protocol fixtures omit official_service and query parameters/credentials.
# JSON and POST SSE responses use a strict per-request total timeout_seconds deadline;
# legacy GET SSE, stdio, OAuth discovery and automatic tool retries are unsupported.
ONMYWAY_MCP_SERVERS_FILE=
